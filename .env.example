# Copy to .env and fill in. .env is git-ignored and read both by the application
# (spring.config.import=optional:file:.env[.properties]) and by docker compose.

# PostgreSQL password (docker compose creates the database with it)
DB_PASSWORD=change-me

# JWT signing key: at least 32 random bytes, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes

# SMTP application password. Not needed with docker compose, which routes mail
# to the bundled mail sink (http://localhost:8025) unless MAIL_HOST is set.
MAIL_PASSWORD=
