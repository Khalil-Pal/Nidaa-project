<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration (DEP-6).

  Every line carries the request id and the authenticated user from the MDC
  (RequestCorrelationFilter, JwtAuthenticationFilter; C-4), so a user's error
  reference or an audit entry can be matched to the exact log lines.

  Console: always. File: logs/nidaa.log (or ${LOG_PATH}), rolled daily or at
  10 MB, kept 14 days and capped at 500 MB in total, so a long-running
  deployment cannot fill the disk.

  Profiles: "prod" logs the application at INFO and never prints SQL
  (spring.jpa.show-sql=false lives in application-prod.properties); every
  other profile keeps the application at DEBUG for development.
-->
<configuration>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-}] [%X{user:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/nidaa.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/nidaa.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <logger name="com.humanitarian.platform" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>
    <springProfile name="!prod">
        <logger name="com.humanitarian.platform" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
